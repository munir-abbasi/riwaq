{
  "$schema": "https://json-schema.org/draft/07/schema#",
  "$id": "https://isnad-builder.app/schemas/narrator-profile.json",
  "title": "NarratorProfile",
  "description": "Canonical profile for a narrator entity, used for entity resolution and reliability tracking.",
  "type": "object",
  "required": ["narrator_id", "names"],
  "properties": {
    "narrator_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "minLength": 1,
      "maxLength": 128
    },
    "names": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    },
    "kunya": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "layla": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "birth": {
      "type": ["object", "null"],
      "properties": {
        "jdn": { "type": ["integer", "null"] },
        "year": { "type": ["integer", "null"] },
        "month": { "type": ["integer", "null"] },
        "day": { "type": ["integer", "null"] },
        "calendar": { "type": "string", "enum": ["hijri", "gregorian"] },
        "description": { "type": ["string", "null"] },
        "is_approximate": { "type": "boolean", "default": false }
      }
    },
    "death": {
      "type": ["object", "null"],
      "properties": {
        "jdn": { "type": ["integer", "null"] },
        "year": { "type": ["integer", "null"] },
        "month": { "type": ["integer", "null"] },
        "day": { "type": ["integer", "null"] },
        "calendar": { "type": "string", "enum": ["hijri", "gregorian"] },
        "description": { "type": ["string", "null"] },
        "is_approximate": { "type": "boolean", "default": false }
      }
    },
    "biographical_notes": {
      "type": ["string", "null"],
      "maxLength": 4096
    },
    "locations": {
      "type": "array",
      "items": { "type": "string", "maxLength": 256 },
      "default": []
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "maxLength": 128 },
      "default": []
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "maxLength": 256 },
      "default": []
    },
    "reliability_evidence": {
      "type": "array",
      "items": { "$ref": "hadith-record.json#/$defs/ReliabilityEvidence" },
      "default": []
    }
  }
}
