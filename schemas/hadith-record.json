{
  "$schema": "https://json-schema.org/draft/07/schema#",
  "$id": "https://isnad-builder.app/schemas/hadith-record.json",
  "title": "HadithRecord",
  "description": "Canonical representation of a single hadith import record. A HadithRecord belongs to exactly one hadith family and contains one or more isnad variants.",
  "type": "object",
  "required": ["hadith_id", "family_id", "source_ref", "variants"],
  "properties": {
    "hadith_id": {
      "$ref": "#/$defs/NarratorIdentifier",
      "description": "Stable, unique identifier for this specific hadith instance within a family."
    },
    "family_id": {
      "$ref": "#/$defs/FamilyIdentifier",
      "description": "Links this record to its hadith family."
    },
    "title": {
      "type": ["string", "null"],
      "description": "Human-readable label for the hadith (e.g., 'Hadith of Gabriel')."
    },
    "source_ref": {
      "$ref": "#/$defs/SourceRef",
      "description": "Structured provenance for the hadith source."
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/IsnadVariant" }
    },
    "matn_raw": {
      "type": ["string", "null"],
      "description": "Raw matn (text) associated with the primary variant."
    },
    "reliability_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/ReliabilityEvidence" },
      "default": []
    }
  },
  "$defs": {
    "NarratorIdentifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "minLength": 1,
      "maxLength": 128,
      "description": "Stable alphanumeric identifier. Must be reusable across variants within a family."
    },
    "FamilyIdentifier": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "minLength": 1,
      "maxLength": 128
    },
    "SourceRef": {
      "type": "object",
      "required": ["collection", "source_type", "source_locator", "ingested_at"],
      "properties": {
        "collection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Name of the hadith collection (e.g., 'Sahih al-Bukhari')."
        },
        "source_type": {
          "type": "string",
          "enum": ["url", "print", "manuscript", "oral_report"],
          "description": "Medium of the source."
        },
        "source_locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "How to locate the source: URL, ISBN/volume/page, manuscript shelfmark/folio, interview reference."
        },
        "ingested_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of when this source was ingested into the system."
        },
        "parser_version": {
          "type": ["string", "null"],
          "description": "Version of the parser/OCR tool that produced this record."
        },
        "checksum": {
          "type": ["string", "null"],
          "description": "SHA-256 or similar checksum of the source data for integrity verification."
        }
      }
    },
    "IsnadVariant": {
      "type": "object",
      "required": ["variant_id", "isnad_chain"],
      "properties": {
        "variant_id": {
          "$ref": "#/$defs/NarratorIdentifier",
          "description": "Unique identifier for this variant within the family."
        },
        "isnad_chain": {
          "type": "array",
          "items": { "$ref": "#/$defs/NarratorIdentifier" },
          "description": "Ordered list of canonical narrator IDs from source to collector (bottom to top in traditional reading)."
        },
        "isnad_raw": {
          "type": ["string", "null"],
          "description": "Original isnad text as written in the source."
        },
        "matn_raw": {
          "type": ["string", "null"],
          "description": "Variant-specific matn text."
        },
        "collector_note": {
          "type": ["string", "null"],
          "description": "Annotation by the compiler/collector of this variant."
        },
        "provenance": {
          "type": ["object", "null"],
          "properties": {
            "manuscript_source": { "type": ["string", "null"] },
            "printed_edition": { "type": ["string", "null"] },
            "transmission_path": { "type": ["string", "null"] }
          }
        }
      }
    },
    "ReliabilityEvidence": {
      "type": "object",
      "required": ["evidence_id", "narrator_id", "rating", "source_type", "source_ref", "ingested_at"],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/NarratorIdentifier"
        },
        "narrator_id": {
          "$ref": "#/$defs/NarratorIdentifier"
        },
        "rating": {
          "type": "string",
          "enum": ["thiqah", "saduq", "majhul", "daif", "matruk", "accused_fabrication"],
          "description": "Scholarly reliability rating."
        },
        "rating_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence weight for this rating evidence (0-1)."
        },
        "scholar": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "work": {
          "type": ["string", "null"],
          "maxLength": 256
        },
        "citation_text": {
          "type": ["string", "null"],
          "maxLength": 1024
        },
        "citation_span": {
          "type": ["string", "null"],
          "description": "Specific volume/page/line reference."
        },
        "dissent_notes": {
          "type": ["string", "null"],
          "maxLength": 512
        },
        "date_layer": {
          "type": ["string", "null"],
          "enum": ["reported", "analytical", "derived", null]
        },
        "source_type": {
          "type": "string",
          "enum": ["url", "print", "manuscript", "oral_report"]
        },
        "source_ref": {
          "$ref": "#/$defs/SourceRef"
        },
        "ingested_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
